<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/first_fragment">

    <fragment
        android:id="@+id/first_fragment"
        android:name="com.example.tms_android_homework.FirstFragment"
        android:label="first_fragment"
        tools:layout="@layout/first_fragment">
        <action
            android:id="@+id/first_to_second"
            app:destination="@+id/second_fragment" />
    </fragment>

    <fragment
        android:id="@+id/second_fragment"
        android:name="com.example.tms_android_homework.SecondFragment"
        android:label="second_fragment"
        tools:layout="@layout/second_fragment">
        <action
            android:id="@+id/second_to_first"
            app:destination="@+id/first_fragment" />
    </fragment>

</navigation>